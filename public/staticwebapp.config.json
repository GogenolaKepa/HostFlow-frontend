{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/*.{css,js,json,png,jpg,jpeg,webp,svg,ico,woff,woff2}"]
  },
  "routes": [
    {
      "route": "/cuenta/*",
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer"
      }
    }
  ],
  "globalHeaders": {
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff"
  }
}
